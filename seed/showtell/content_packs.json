    "json": {
      "title": "Week 1: My Favorite Toy",
      "description": "Learn to present about your favorite toy in English",
      "day1": {
        "write": {
          "prompt": "Write about your favorite toy. Describe what it looks like, why you like it, and how you play with it.",
          "guide_questions": [
            "What is your favorite toy?",
            "What does it look like?",
            "Why do you like it?",
            "How do you play with it?",
            "When did you get it?"
          ],
          "min_words": 50,
          "max_words": 150
        },
        "fix": {
          "enabled": true,
          "correction_focus": ["grammar", "vocabulary", "structure"]
        }
      },
      "day2": {
        "script_coach": {
          "target_duration_seconds": 30,
          "structure_template": {
            "intro": "Hello! Today I'm going to tell you about my favorite toy.",
            "body": [
              "Introduce your toy and describe what it looks like",
              "Explain why it's your favorite",
              "Share how you play with it"
            ],
            "conclusion": "That's why this toy is my favorite. Thank you for listening!"
          },
          "tips": [
            "Speak clearly and slowly",
            "Use simple sentences",
            "Add details about colors, size, and feelings"
          ]
        },
        "tts": {
          "enabled": true,
          "voice": "en-US-Standard-C"
        },
        "shadowing": {
          "enabled": true,
          "max_attempts": 3
        }
      },
      "day3": {
        "rehearsal": {
          "max_attempts": 2,
          "feedback_focus": ["pronunciation", "fluency", "content"]
        },
        "judge": {
          "question_bank_ref": "judge_week1",
          "question_count": 5,
          "time_limit_seconds": 30
        }
      },
      "portfolio": {
        "card_title": "Week 1: My Favorite Toy",
        "card_description": "My first Show & Tell presentation about my favorite toy",
        "save_items": ["final_script", "final_recording", "judge_qa"]
