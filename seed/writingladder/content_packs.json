      "title": "Week 1: I like... (Things I Like)",
      "description": "Learn to write simple sentences about things you like",
      "day1": {
        "write": {
          "prompt": "Write 3-5 simple sentences about things you like. Start each sentence with 'I like...'",
          "guide_questions": [
            "What food do you like?",
            "What color do you like?",
            "What animal do you like?",
            "What game do you like?",
            "What is your favorite thing?"
          ],
          "min_words": 15,
          "max_words": 50
        },
        "fix": {
          "enabled": true,
          "correction_focus": ["grammar", "vocabulary", "sentence_structure"]
        }
      },
      "day2": {
        "script_coach": {
          "target_duration_seconds": 15,
          "structure_template": {
            "intro": "Hello! I want to tell you about things I like.",
            "body": [
              "Say your sentences one by one",
              "Speak clearly and slowly",
              "Smile and make eye contact"
            ],
            "conclusion": "Thank you for listening!"
          },
          "tips": [
            "Speak slowly and clearly",
            "Take a breath between sentences",
            "Use your voice to show excitement"
          ]
        },
        "tts": {
          "enabled": true,
          "voice": "en-US-Standard-C"
        },
        "shadowing": {
          "enabled": true,
          "max_attempts": 3
        }
      },
      "day3": {
        "rehearsal": {
          "max_attempts": 2,
          "feedback_focus": ["pronunciation", "fluency", "confidence"]
        },
        "judge": {
          "question_bank_ref": "judge_writingladder_l0_week1",
          "question_count": 5,
          "time_limit_seconds": 20
